{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "finan",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/.well-known/*",
      "/openapi.json",
      "/auth.md",
      "/js/webmcp.js",
      "/planos",
      "/sobre-nos",
      "/calculadora-bdi",
      "/calculadora-bdi.html",
      "/api/*",
      "/__finobra/health",
      "/",
      "/index.html",
      "/app.html",
      "/login.html",
      "/landing.html",
      "/master.html",
      "/privacidade.html",
      "/termos.html",
      "/validar.html",
      "/llms.txt",
      "/llms-full.txt",
      "/app",
      "/app/*",
      "/landing",
      "/master",
      "/privacidade",
      "/termos",
      "/validar",
      "/login",
      "/cadastro",
      "/apresentacao",
      "/comercial",
      "/portal",
      "/portal/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS_R2",
      "bucket_name": "fingo-attachments"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "FINOBRA_API_ORIGIN": "https://api.fingo.api.br",
    "FINOBRA_CANONICAL_ORIGIN": "https://fingo.api.br",
    "RENDER_HEALTH_URL": "https://finan-backend-9rxw.onrender.com/healthz"
  }
}
