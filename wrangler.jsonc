{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "finan",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/__finobra/health",
      "/",
      "/app",
      "/app/*",
      "/landing",
      "/master",
      "/privacidade",
      "/termos",
      "/validar",
      "/login",
      "/cadastro",
      "/apresentacao",
      "/comercial"
    ]
  },
  "vars": {
    "FINOBRA_API_ORIGIN": "https://api.finobra.app.br",
    "FINOBRA_CANONICAL_ORIGIN": "https://finobra.app.br"
  }
}
