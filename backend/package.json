{
  "name": "finobra-backend-render",
  "version": "1.1.0",
  "description": "Backend 24/7 do FinObra no Render com Neon PostgreSQL, WhatsApp e API de Negócio",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),t=p.resolve('../node_modules'),s=p.resolve('node_modules');if(!fs.existsSync(t)&&fs.existsSync(s)){try{fs.symlinkSync(s,t,'junction')}catch(e){console.warn('symlink:',e.message)}}\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@trigger.dev/sdk": "^4.6.2",
    "@vercel/blob": "^2.8.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "google-auth-library": "^11.0.2",
    "node-cron": "^4.6.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "qs": "6.16.0",
    "ws": "^8.21.3"
  }
}
