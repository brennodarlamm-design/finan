# ==============================================================================
# FinGo SaaS — Environment Variables Template (.env.example)
# ==============================================================================
# IMPORTANTE: Este é apenas um arquivo de exemplo com valores fictícios/placeholders.
# NUNCA insira credenciais reais de produção aqui.
# Para desenvolvimento local, copie este arquivo para .env.local (ignorado pelo git).
# ==============================================================================

# Porta do servidor backend Node.js
PORT=3001

# Banco de Dados PostgreSQL (Neon Serverless)
# Formato: postgresql://[USER]:[PASS]@[HOST]/neondb?sslmode=require
DATABASE_URL=postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]/neondb?sslmode=require

# Criptografia, Sessões e Autenticação
SESSION_SECRET=substitua_por_uma_chave_aleatoria_longa_hex_ou_base64
JWT_SECRET=substitua_por_um_segredo_jwt_aleatorio_minimo_32_caracteres
MASTER_SECRET_KEY=substitua_por_um_segredo_mestre_para_administracao

# Cloudflare (Workers, Pages, KV e R2 Storage)
CLOUDFLARE_ACCOUNT_ID=seu_account_id_cloudflare
CLOUDFLARE_API_TOKEN=seu_token_api_cloudflare
ATTACHMENTS_R2_BUCKET=fingo-attachments

# Upstash Redis (Cache Distribuído e Rate Limiting)
UPSTASH_REDIS_REST_URL=https://[REDIS_HOST].upstash.io
UPSTASH_REDIS_REST_TOKEN=seu_token_upstash_redis

# Monitoramento de Erros (Sentry)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Evolution Go / WhatsApp Gateway
EVOLUTION_API_URL=https://whatsapp.fingo.api.br
EVOLUTION_API_KEY=sua_chave_evolution_api

# Render (Deploy & Orquestração Backend)
RENDER_API_KEY=sua_chave_api_render
RENDER_SERVICE_ID=srv_exemplo123

# Auditoria 2026-10-02
# Webhook do Resend (Svix): copie o "Signing secret" (whsec_...) do painel do Resend
RESEND_WEBHOOK_SECRET=whsec_substitua_pelo_signing_secret_do_resend
# Chave de cifra do backup diário no R2 (mín. 32 caracteres aleatórios; guarde fora do repositório)
BACKUP_ENCRYPTION_KEY=substitua_por_uma_chave_aleatoria_de_no_minimo_32_caracteres
# Segredo compartilhado Worker -> Render (mesmo valor no wrangler secret e no Render)
ORIGIN_SHARED_SECRET=substitua_por_um_segredo_aleatorio_longo
ORIGIN_ENFORCE_EDGE=false

# Assinatura dos links do Portal do Cliente (opcional; mín. 32 caracteres).
# Sem ela, usa chave derivada de SESSION_SIGNING_SECRET. Trocar invalida links já enviados.
PORTAL_LINK_SECRET=

# Facebook Marketing / Ads API
FACEBOOK_APP_ID=seu_app_id_facebook
FACEBOOK_ADS_ACCESS_TOKEN=seu_access_token_facebook_ads

# Cobrança PIX SaaS FinGo
FINOBRA_PIX_KEY=
FINOBRA_PIX_MERCHANT_NAME=
FINOBRA_PIX_BENEFICIARY=
FINOBRA_PIX_CITY=
