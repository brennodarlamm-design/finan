# ==============================================================================
# FinGo — Git Ignore Configuration (.gitignore)
# ==============================================================================

# Dependências
node_modules/
backend/node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Autenticação WhatsApp e sessões locais do backend
auth_info_baileys/
backend/auth_info_baileys/
*/auth_info_baileys/

# Variáveis locais e credenciais sensíveis (NUNCA versionar)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
.env*.local
.env.vault
.env.backup
.sentryclirc
*.sentryclirc
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
*.jks
*.keystore
id_rsa
id_ed25519
*.secret

# Logs & Diagnósticos
*.log
logs/
*/logs/
scratch-startup-tests.log

# NF-e & Monitor Local
monitor-nfe/logs/
monitor-nfe/config.json
monitor-nfe/ultimo_nsu.txt
monitor-nfe/xmls/
monitor-nfe/whatsapp-server/

# Vercel, Cloudflare, Trigger.dev, Render & Miniflare
.vercel/
.wrangler/
.trigger/
.render/
.mf/

# Build & Caches
dist/
build/
.next/
.turbo/
.cache/
.output/
.vite/
.eslintcache
*.tsbuildinfo
.marketing-dist/

# Testes, Cobertura & Relatórios
coverage/
.nyc_output/
test-results/
playwright-report/

# Backups temporários, binários locais, arquivos scratch & pacotes
*.tmp
*.bak
*.swp
*.swo
*~
bin/
scratch/
*.zip
*.tar.gz
*.tar
*.tgz
*.rar
*.7z
.release_temp/

# Sistema Operacional
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editores & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj

# Python & Caches locais de Skills
__pycache__/
*.py[cod]
*$py.class
