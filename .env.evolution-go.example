# ==============================================================================
# FinGo — Variáveis de Ambiente para Integração com Evolution Go (Golang)
# ==============================================================================

# URL base onde o container do Evolution Go está respondendo
# Localmente (via Docker Compose): http://localhost:8085
# No Render / Cloud: https://seu-evolution-go.onrender.com
EVOLUTION_GO_URL=http://localhost:8085

# Chave secreta de autenticação (GLOBAL_API_KEY configurada no Evolution Go)
EVOLUTION_GO_API_KEY=fingo-evo-secret-change-me-in-production

# Porta exposta no host para o container Docker
EVOLUTION_GO_PORT=8085

# Banco de dados PostgreSQL (pode ser o mesmo Neon do FinGo com string dedicada ou banco local)
# Exemplo Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
POSTGRES_AUTH_DB=postgresql://postgres:postgres@localhost:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:postgres@localhost:5432/evogo_users?sslmode=disable

# Webhook para onde o Evolution Go deve despachar mensagens recebidas do cliente
# Local: http://host.docker.internal:3333/api/whatsapp?action=webhook
# Produção: https://api.fingo.api.br/api/whatsapp?action=webhook
EVOLUTION_GO_WEBHOOK_URL=http://host.docker.internal:3333/api/whatsapp?action=webhook
